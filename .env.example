APP_NAME=python-fastapi
DEBUG=false

# Selects the Dockerfile build stage: development or production
ENVIRONMENT=development

POSTGRES_USER=fastapi
POSTGRES_PASSWORD=fastapi
POSTGRES_DB=fastapi
DATABASE_URL=postgresql+asyncpg://fastapi:fastapi@db:5432/fastapi
TEST_DATABASE_URL=postgresql+asyncpg://fastapi:fastapi@db:5432/fastapi_test

JWT_SECRET_KEY=change-me-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
